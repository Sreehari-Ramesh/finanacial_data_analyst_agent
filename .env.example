# LLM Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI Configuration (if using OpenAI instead)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ── SQL Server Connection ────────────────────────────────────────────────────
# Server name or IP address (use "localhost" or ".\SQLEXPRESS" for local)
DB_SERVER=localhost

# SQL Server port (default: 1433)
DB_PORT=1433

# Database name to connect to
DB_NAME=your_database_name

# ODBC driver installed on your machine
# Common values:
#   ODBC Driver 17 for SQL Server
#   ODBC Driver 18 for SQL Server
#   SQL Server
DB_DRIVER=ODBC Driver 17 for SQL Server

# SQL Server Authentication
DB_USERNAME=sa
DB_PASSWORD=your_password

# Set to "true" to use Windows Integrated Authentication instead (ignores username/password)
DB_WINDOWS_AUTH=false

# ── Optional ─────────────────────────────────────────────────────────────────
# Reports output directory
REPORTS_DIR=reports

# Max SQL retries on error
MAX_RETRIES=3
